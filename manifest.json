{
  "manifest_version": 3,
  "name": "Hide Kindle Orders",
  "version": "1.1.1",
  "description": "Hides Kindle orders on the Amazon.co.jp order history page.",
  "browser_specific_settings": {
    "gecko": {
      "data_collection_permissions": {
        "required": ["none"]
      },
      "id": "amazon-order-hide-kindle@piro0919",
      "strict_min_version": "115.0"
    }
  },
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.amazon.co.jp/gp/css/order-history*",
        "*://www.amazon.co.jp/gp/your-account/order-history*",
        "*://www.amazon.co.jp/your-orders/*",
        "*://www.amazon.co.jp/gp/css/summary/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
